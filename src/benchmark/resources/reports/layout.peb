<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Presence · {{ title }}</title>
  <style>
    :root{font:16px/1.6 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#171717;background:#f5f5f5;color-scheme:light}
    *{box-sizing:border-box}body{max-width:1320px;margin:auto;padding:42px 24px 64px}
    header{border-top:5px solid #111;padding:24px 0 12px}h1{font-size:clamp(34px,5vw,58px);line-height:1.08;letter-spacing:-.045em;margin:.2em 0}
    h2{font-size:24px;letter-spacing:-.025em;margin-top:0}h3{font-size:18px}p{max-width:1100px}a{color:#111;text-underline-offset:3px}
    section{background:#fff;border:1px solid #dedede;border-radius:8px;padding:26px;margin:24px 0}
    .eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:12px;color:#666}
    .notice{padding:18px 20px;border-left:4px solid #444;background:#eaeaea}
    .summary{display:flex;gap:32px;flex-wrap:wrap;margin:25px 0}.summary strong{display:block;font-size:29px;font-weight:600}.summary span{color:#666;font-size:13px}
    .scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
    th,td{padding:11px 10px;border-bottom:1px solid #e4e4e4;text-align:right;white-space:nowrap;vertical-align:top}
    th{color:#666;font-size:11px;text-transform:uppercase;letter-spacing:.045em}th:first-child,td:first-child{text-align:left}
    svg{width:100%;min-width:700px;font:13px system-ui,sans-serif;margin:14px 0}
    code,pre{font:13px/1.6 ui-monospace,Consolas,monospace}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f3f3f3;padding:16px}
    footer{font-size:13px;color:#666}details{margin:16px 0}summary{cursor:pointer}.wrap{overflow-wrap:anywhere}
    @media(max-width:650px){body{padding:20px 12px}section{padding:18px}h2{font-size:21px}}
  </style>
</head>
<body>
<header><p class="eyebrow">Transductive / Presence / local review</p><h1>{{ title }}</h1></header>
{% block content %}{% endblock %}
<footer>Generated locally with Java and Pebble. Standalone HTML with no external scripts, fonts, or network requests. Keep the full report directory when sharing.</footer>
</body>
</html>
